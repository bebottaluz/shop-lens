{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "--workspace",
        "backend",
        "run",
        "start:dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "--workspace",
        "frontend",
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Both",
      "dependsOn": [
        "Start Backend",
        "Start Frontend"
      ]
    }
  ]
}
